{
  "name": "sudoku",
  "version": "1.0.3",
  "description": "a sudoku game",
  "license": "GPL-3.0-or-later",
  "main": "dist/sudoku.min.js",
  "types": "sudoku.d.ts",
  "exports": {
    ".": "./dist/sudoku.js",
    "./assets/*": "./assets/*",
    "./*": "./dist/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "bundle": "esbuild src/sudoku.ts --bundle --format=esm  --loader:.svg=dataurl --outfile=dist/sudoku.min.js --minify",
    "dev": "esbuild src/sudoku.ts --bundle --format=esm  --loader:.svg=dataurl --outfile=dev/sudoku.js --watch",
    "dist": "$npm_execpath run compile && $npm_execpath run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "$npm_execpath run compile",
    "compile": "tsc --sourceMap --declaration",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check-format": "oxfmt --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  }
}
