{
  "name": "sudoku",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "types": "dist/sudoku.d.ts",
  "description": "sudoku created by rhnh",
  "main": "dist/sudoku.min.js",
  "scripts": {
    "prepare": "$npm_execpath run compile",
    "compile": "tsc --sourceMap --declaration",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check-format": "oxfmt --check",
    "dist": "$npm_execpath run compile && $npm_execpath run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "esbuild  src/sudoku.ts --bundle --format=esm --outfile=dist/sudoku.min.js --loader:.eot=file --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file",
    "dev": "$npm_execpath run build --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-golden": "^0.1.2",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": "https://github.com/rhnh/sudoku",
  "devDependencies": {
    "madge": "^8.0.0"
  }
}
